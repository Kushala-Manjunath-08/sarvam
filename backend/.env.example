# Optional grounded answer generation. Without a key, chat returns retrieved
# evidence excerpts with citations and makes no generated claims.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Optional semantic retrieval. Install sentence-transformers and set a model
# available locally or from Hugging Face; unset this to use SQLite keyword search.
SARVAM_EMBEDDING_MODEL=

# Required only for protected admin and reindex routes.
KARAVALI_ADMIN_TOKEN=
