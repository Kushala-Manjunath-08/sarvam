# ==============================================================
# LEGACYOS — Environment Variable Template
# ==============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ==============================================================

# ------ Frontend (Next.js) ------
# Base URL of the backend API (used for server-side API calls)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application environment
NEXT_PUBLIC_APP_ENV=development

# ------ Backend (FastAPI) — PLANNED Phase 3 ------
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/legacyos

# JWT secret key for authentication token signing
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT token expiry (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------ AI Services — PLANNED Phase 5/6 ------
# Groq API key for LLM inference (knowledge extraction + RAG chat)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for knowledge extraction
GROQ_MODEL=llama3-8b-8192

# ------ Vector Database — PLANNED Phase 6 ------
# ChromaDB host and port
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ------ Knowledge Graph — PLANNED Phase 7 (Optional) ------
# Neo4j connection details
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ------ File Storage — PLANNED Phase 4 ------
# S3-compatible object storage credentials
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=legacyos-media
STORAGE_REGION=ap-south-1
