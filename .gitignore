# ============================================================
# LEGACYOS — .gitignore
# ============================================================

# ----- Node.js / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ----- Next.js -----
.next/
out/
build/
dist/

# ----- Environment Variables (NEVER COMMIT THESE) -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ----- Database -----
*.sqlite3
*.db

# ----- AI / ML -----
*.pt
*.pth
*.onnx
chroma_db/
chromadb/

# ----- IDE and Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS Generated -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----- Logs -----
logs/
*.log

# ----- Uploads and Media (do not commit user data) -----
uploads/
media/
